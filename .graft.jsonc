{
  "source": {
    "github": {
      // An issue is ready only when it carries every one of these.
      "ready_labels": ["graft:ready"]
    },
    "local": {
      // One markdown file per task.
      "dir": ".graft/tasks"
    }
  },
  "worktree": {
    // "auto" leaves the worktree to the agent when it makes one itself.
    "mode": "auto",
    "name": "graft-{{.GraftID}}",
    "dir": ".graft/worktrees",
    // The ref a graft's branch starts from. Naming the remote branch keeps
    // grafts off whatever you happen to have checked out; drop the key to
    // follow git and branch off HEAD, or pass --from-current for one run.
    "from": "origin/main"
  },
  "log": {
    // Where the graft log and the rendered prompt are written.
    "dir": ".graft/logs"
  },
  "prompt": {
    // One markdown file per briefing, the way .github/ISSUE_TEMPLATE holds
    // one per kind of issue. A graft is asked which one to use; --prompt
    // <name> names one outright and "default" is the built-in briefing.
    "template_dir": ".graft/prompts",
    // The rendered prompt is shown before the agent is started, so it can be
    // read and edited. Set it to false to hand it over unseen.
    "edit": true
  },
  // A monorepo names its modules here, by their path from this file. A graft
  // taken up in one of them — cd into it, or "graft -C apps/web" — is briefed
  // by its own templates and starts the agent in the module rather than at
  // the root of the checkout. Only the briefings are a module's own;
  // everything else about a graft is the repository's.
  //
  // "modules": {
  //   "apps/web": {"prompt": {"template_dir": "apps/web/prompts", "default": "feature"}},
  //   "services/api": {"prompt": {"template_dir": "services/api/prompts"}}
  // }
}
