{
  "name": "aka",
  "version": "0.1.0",
  "private": true,
  "description": "aka - a lightweight, offline-first annotation & design tool for developers, QA and PO",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build crate --release --target web --out-dir ../src/wasm --out-name aka_core",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:web",
    "test:core": "cargo test --manifest-path crate/Cargo.toml",
    "test:web": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1"
  }
}
